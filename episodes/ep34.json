          "say": "How long?",
          "quiet": true
        },
        {
          "who": "pip",
          "say": "Since we got back. I didn't read it.",
          "face": "soft"
        },
        {
          "who": "bash",
          "say": "What is it?"
        },
        {
          "who": "riot",
          "say": "I got a place in the city. Two and a half years ago. Full swimming scholarship.",
