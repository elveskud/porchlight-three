        {
          "who": "riot",
          "say": "I'm just saying. We've got it right here. All of this.",
          "face": "soft"
        },
        {
          "who": "riot",
          "say": "We could have this tomorrow, and the day after. Every day. Forever.",
          "face": "soft"
