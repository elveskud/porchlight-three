        },
        {
          "who": "bash",
          "say": "You what?",
          "face": "shocked"
        },
        {
          "who": "riot",
          "say": "I turned it down. I never told anyone. I told Dad I'd missed the date.",
          "face": "sad"
        },
        {
          "who": "rocco",
          "say": "You were the fastest kid in the county.",
          "quiet": true
        },
        {
          "who": "riot",
          "say": "You knew?",
          "face": "shocked"
        },
        {
          "who": "rocco",
          "say": "I noticed a letter. Then no letter. I wrote it down. I should've said.",
          "face": "deadpan"
        },
        {
          "who": "riot",
          "say": "I stayed because of you. All of you. This street.",
          "face": "sad"
        },
        {
          "who": "riot",
          "say": "And Grandpa's game, I thought I had to... I gave it all up, to be here.",
          "face": "sad"
        },
        {
          "who": "riot",
          "say": "And now if I finish it, this is gone too. Then what did I do it for?",
          "face": "sad",
          "quiet": true
        }
